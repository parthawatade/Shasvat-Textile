# Shasvat Textiles — External Integration Environment Variables
# Configure live values via the Secrets panel in AI Studio.
# Never put API secret keys (such as RAZORPAY_KEY_SECRET) in the Android client!

# Public Razorpay Checkout Key ID (e.g., rzp_test_... or rzp_live_...)
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID

# Backend server base URL for payment order creation, signature verification, and webhooks
PAYMENT_BACKEND_URL=YOUR_PAYMENT_BACKEND_URL

# Backend webhook URL for dispatching Email, SMS, and WhatsApp order notifications
NOTIFICATION_WEBHOOK_URL=YOUR_NOTIFICATION_WEBHOOK_URL
